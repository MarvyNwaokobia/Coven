# Copy to .env.local and fill in. See README §13.

# ── Supabase (create project at supabase.com, run supabase/schema.sql) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Arc Testnet — see ARC_TESTNET.md ──
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
# Deployed 2026-07-20 — see ARC_TESTNET.md §6 "Live testnet deployment"
NEXT_PUBLIC_PAYCIRCLE_CONTRACT=0x5f4c5E9DA66935732e464F447d15E37E33E2daA4
NEXT_PUBLIC_SPLIT_ESCROW_CONTRACT=0x72AC36A822746a51b0Ff03Df15df19B3E4B5536E

# ── Circle (console.circle.com — Programmable Wallets) ──
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# ── CCTP — Arc's domain is 26 (TokenMessengerV2 0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA) ──
CCTP_ATTESTATION_API=https://iris-api-sandbox.circle.com
ARC_MESSAGE_TRANSMITTER_ADDRESS=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
NEXT_PUBLIC_ARC_CCTP_DOMAIN=26

# ── Yellow Card (partner API key) ──
YELLOW_CARD_API_KEY=
YELLOW_CARD_SANDBOX=true

# ── Notifications (optional for demo) ──
NEXT_PUBLIC_EXPO_PROJECT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=

# ── Encryption for bank account numbers: openssl rand -hex 32 ──
ENCRYPTION_KEY=

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLATFORM_FEE_WALLET=
