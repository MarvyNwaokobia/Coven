# Copy to .env.local and fill in. See README §13.

# ── Supabase (create project at supabase.com, run supabase/schema.sql) ──
# Auth: enable the Google provider under Dashboard → Authentication →
# Providers, using a Google Cloud OAuth client ID/secret. Add both
# https://<project>.supabase.co/auth/v1/callback (Google's authorized
# redirect URI) and ${NEXT_PUBLIC_APP_URL}/auth/callback (Supabase's
# "Redirect URLs" allowlist) — see app/signup/page.tsx + app/auth/callback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Arc Testnet — see docs/ARC_TESTNET.md ──
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Server-side signer for CCTP relay + any backend-initiated contract calls.
# Needs its own testnet USDC for gas — see lib/cctp/crossChainPay.ts and
# lib/contracts/index.ts. (Contract deployment uses a separate key in
# contract/.env — DEPLOYER_PRIVATE_KEY isn't read by the frontend.)
RELAYER_PRIVATE_KEY=
# Deployed 2026-07-20 — see docs/ARC_TESTNET.md §6 "Live testnet deployment"
NEXT_PUBLIC_PAYCIRCLE_CONTRACT=0x5f4c5E9DA66935732e464F447d15E37E33E2daA4
NEXT_PUBLIC_SPLIT_ESCROW_CONTRACT=0x72AC36A822746a51b0Ff03Df15df19B3E4B5536E
# Deployed 2026-07-25 — group savings pool (variable contributions,
# unanimous-approval withdrawal). See contract/src/GoalPool.sol.
NEXT_PUBLIC_GOAL_POOL_CONTRACT=0xB496516bAAb570d73208a5210e4E95381751f428

# ── Circle (console.circle.com — Programmable Wallets, User-Controlled) ──
# App ID: Console → Wallets → User Controlled → Configurator. Required by
# the client-side Web SDK for PIN setup/approval widgets — see
# lib/circle/challenge.ts, components/WalletSetup.tsx.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_BLOCKCHAIN=ARC-TESTNET
NEXT_PUBLIC_CIRCLE_APP_ID=
# Circle's internal token-catalog id for the ERC20 USDC representation on
# ARC-TESTNET (not the same as ARC_USDC_ADDRESS above — Circle's transfer
# API needs this id, not the raw contract address, since Arc has both a
# native 18-decimal USDC gas token and this ERC20 6-decimal one at the same
# address). Confirmed live via GET /wallets/{id}/balances → tokenBalances[].token.id
# where standard === "ERC20". Not sensitive — same value for every wallet on this chain.
ARC_USDC_TOKEN_ID=ef87c8c3-85de-598a-af50-c5135eecfa74

# ── CCTP — Arc's domain is 26 (TokenMessengerV2 0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA) ──
CCTP_ATTESTATION_API=https://iris-api-sandbox.circle.com
ARC_MESSAGE_TRANSMITTER_ADDRESS=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
NEXT_PUBLIC_ARC_CCTP_DOMAIN=26
# Source-chain RPCs for the CCTP burn leg. Optional — lib/cctp/crossChainPay.ts
# falls back to public endpoints. They are NOT optional to the SDK itself:
# its testnet registry ships every chain with rpc: undefined, so with no
# override viem throws "No URL was provided to the Transport".
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_POLYGON_RPC_URL=
NEXT_PUBLIC_ARBITRUM_RPC_URL=
NEXT_PUBLIC_ARC_RPC_URL=

# ── Yellow Card (partner API key) ──
YELLOW_CARD_API_KEY=
YELLOW_CARD_SANDBOX=true

# ── Notifications (optional for demo; unrelated to auth — sign-in is
# Google OAuth via Supabase, no SMS/email code to send) ──
NEXT_PUBLIC_EXPO_PROJECT_ID=
RESEND_API_KEY=

# ── Encryption for bank account numbers: openssl rand -hex 32 ──
ENCRYPTION_KEY=

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLATFORM_FEE_WALLET=
